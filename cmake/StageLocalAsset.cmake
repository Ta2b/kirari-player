# Assemble l'arbre d'exécution d'un build. Les ressources d'un SDK peuvent peser plusieurs Gio.
# Le paquet installé est copié séparément par les règles install().
if(NOT EXISTS "${source}")
  message(FATAL_ERROR "Ressource de construction absente : ${source}")
endif()
file(REAL_PATH "${source}" resolved)
if(EXISTS "${destination}")
  file(REAL_PATH "${destination}" current)
  if(resolved STREQUAL current)
    return()
  endif()
endif()
cmake_path(GET destination PARENT_PATH folder)
file(MAKE_DIRECTORY "${folder}")
if(WIN32)
  if(IS_DIRECTORY "${source}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory_if_different "${source}" "${destination}"
                    COMMAND_ERROR_IS_FATAL ANY)
  else()
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT)
  endif()
else()
  file(CREATE_LINK "${source}" "${destination}" SYMBOLIC)
endif()
