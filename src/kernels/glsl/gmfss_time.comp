#version 450
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"
layout(local_size_x=16, local_size_y=16) in;
layout(std430,binding=0) writeonly buffer Time { KIRARI_TENSOR v[]; } dst;
layout(std430,binding=1) readonly buffer Instant { float s; } instant;
layout(push_constant) uniform Push { uint width; uint height; } pc;
void main() {
  uvec3 p=gl_GlobalInvocationID;
  if(p.x<pc.width && p.y<pc.height) dst.v[(p.z*pc.height+p.y)*pc.width+p.x]=KIRARI_TENSOR(instant.s);
}
